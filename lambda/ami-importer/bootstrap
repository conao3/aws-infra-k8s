#!/bin/bash
set -euxo pipefail -o posix

process_event() {
  local event="$1"

  local prefix
  prefix=$(echo "$event" | jq -r '.prefix')

  local s3_uri
  s3_uri=$(echo "$event" | jq -r '.s3_uri')

  local import_task_id
  import_task_id=$(echo "$event" | jq -r '.import_task_id // empty')

  local s3_bucket="${s3_uri#s3://}"
  s3_bucket="${s3_bucket%%/*}"

  local s3_key="${s3_uri#s3://*/}"

  local timestamp
  timestamp=$(echo "$s3_key" | grep -oP 'nixos-custom-\K[0-9-]+' || date +%Y%m%d-%H%M%S)

  if [ -z "$import_task_id" ] || [ "$import_task_id" = "null" ]; then
    echo "Starting import-image for ${s3_uri}" >&2

    import_task_id=$(aws ec2 import-image \
      --description "NixOS Custom EC2 Image ${timestamp}" \
      --architecture arm64 \
      --platform Linux \
      --disk-containers "Format=VHD,UserBucket={S3Bucket=${s3_bucket},S3Key=${s3_key}}" \
      --query 'ImportTaskId' \
      --output text)

    echo "Import task started: ${import_task_id}" >&2

    aws ssm put-parameter \
      --name "/${prefix}/ami-builder/import-task-id" \
      --value "${import_task_id}" \
      --type String \
      --overwrite >&2
  else
    echo "Resuming import task: ${import_task_id}" >&2
  fi

  local start_time
  start_time=$(date +%s)
  local max_duration=870

  while true; do
    local elapsed=$(($(date +%s) - start_time))

    if [ $elapsed -ge $max_duration ]; then
      echo "Timeout approaching (elapsed: ${elapsed}s)" >&2
      echo "{\"errorType\":\"ImportInProgress\",\"errorMessage\":\"${import_task_id}\"}"
      return 1
    fi

    local status
    status=$(aws ec2 describe-import-image-tasks \
      --import-task-ids "${import_task_id}" \
      --query 'ImportImageTasks[0].Status' \
      --output text)

    echo "Import status: ${status}, elapsed: ${elapsed}s" >&2

    if [ "$status" = "completed" ]; then
      local ami_id
      ami_id=$(aws ec2 describe-import-image-tasks \
        --import-task-ids "${import_task_id}" \
        --query 'ImportImageTasks[0].ImageId' \
        --output text)

      echo "Import completed: ${ami_id}" >&2

      aws ssm put-parameter \
        --name "/${prefix}/custom-ami-id" \
        --value "${ami_id}" \
        --type String \
        --overwrite >&2

      echo "{\"import_task_id\":\"${import_task_id}\",\"ami_id\":\"${ami_id}\",\"status\":\"completed\"}"
      return 0
    elif [ "$status" = "active" ] || [ "$status" = "pending" ]; then
      sleep 30
    else
      local status_message
      status_message=$(aws ec2 describe-import-image-tasks \
        --import-task-ids "${import_task_id}" \
        --query 'ImportImageTasks[0].StatusMessage' \
        --output text 2>/dev/null || echo "Unknown error")

      echo "Import failed: ${status} - ${status_message}" >&2
      echo "{\"errorType\":\"ImportFailed\",\"errorMessage\":\"${status} - ${status_message}\"}"
      return 1
    fi
  done
}

while true; do
  HEADERS="$(mktemp)"
  EVENT_DATA=$(curl -sS -LD "$HEADERS" -X GET "http://${AWS_LAMBDA_RUNTIME_API}/2018-06-01/runtime/invocation/next")
  REQUEST_ID=$(grep -Fi Lambda-Runtime-Aws-Request-Id "$HEADERS" | tr -d '[:space:]' | cut -d: -f2)

  RESPONSE=$(process_event "$EVENT_DATA" 2>&1 || echo "{\"errorMessage\":\"$?\",\"errorType\":\"HandlerError\"}")

  curl -X POST "http://${AWS_LAMBDA_RUNTIME_API}/2018-06-01/runtime/invocation/$REQUEST_ID/response" -d "$RESPONSE"
done
