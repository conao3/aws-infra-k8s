#!/usr/bin/env bash
set -euxo pipefail -o posix

PREFIX="${PREFIX:-dev-k8s}"
ASG_NAME="${PREFIX}-node"
KEY_FILE="${HOME}/.ssh/${PREFIX}-keypair.pem"

get_instance_info() {
  local filter="${1:-}"
  local query

  case "${filter}" in
    healthy)
      query="AutoScalingGroups[0].Instances[?HealthStatus==\`Healthy\` && LifecycleState==\`InService\`].InstanceId | [0]"
      ;;
    warmup)
      query="AutoScalingGroups[0].Instances[?LifecycleState==\`InService\` || LifecycleState==\`Pending:Wait\`] | sort_by(@, &LaunchTime) | [-1].InstanceId"
      ;;
    *)
      query="AutoScalingGroups[0].Instances[0].InstanceId"
      ;;
  esac

  INSTANCE_ID=$(aws autoscaling describe-auto-scaling-groups \
    --auto-scaling-group-names "${ASG_NAME}" \
    --query "${query}" \
    --output text)

  if [ -z "${INSTANCE_ID}" ] || [ "${INSTANCE_ID}" = "None" ]; then
    echo "Error: No instance found in AutoScaling Group ${ASG_NAME}" >&2
    exit 1
  fi

  PRIVATE_IP=$(aws ec2 describe-instances \
    --instance-ids "${INSTANCE_ID}" \
    --query "Reservations[0].Instances[0].PrivateIpAddress" \
    --output text)
}

cmd_deploy() {
  local kubeconfig_file="target/kubeconfig"

  if [ ! -f "${kubeconfig_file}" ]; then
    echo "Error: ${kubeconfig_file} not found." >&2
    echo "Run 'bin/k8s port-forward' or 'bin/k8s port-forward-warmup' first." >&2
    exit 1
  fi

  if ! nc -z localhost 6443 2>/dev/null; then
    echo "Error: Kubernetes API server is not available at localhost:6443" >&2
    echo "Run 'bin/k8s port-forward' or 'bin/k8s port-forward-warmup' first." >&2
    exit 1
  fi

  MANIFESTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/k8s"
  TEMP_DIR=$(mktemp -d)
  trap 'rm -rf "${TEMP_DIR}"' EXIT

  cp -r "${MANIFESTS_DIR}"/* "${TEMP_DIR}/"

  EFS_FILE_SYSTEM_ID=$(aws cloudformation list-exports \
    --query "Exports[?Name=='${PREFIX}-EfsFileSystemId'].Value" \
    --output text)

  if [ -z "${EFS_FILE_SYSTEM_ID}" ] || [ "${EFS_FILE_SYSTEM_ID}" = "None" ]; then
    echo "Error: EFS File System ID not found in CloudFormation exports" >&2
    exit 1
  fi

  sed -i.bak "s/\${EFS_FILE_SYSTEM_ID}/${EFS_FILE_SYSTEM_ID}/g" "${TEMP_DIR}/aws-efs-csi-driver/storageclass.yaml"

  COGNITO_USER_POOL_ID=$(aws cloudformation list-exports \
    --query "Exports[?Name=='${PREFIX}-UserPool'].Value" \
    --output text)
  COGNITO_CLIENT_ID=$(aws cloudformation list-exports \
    --query "Exports[?Name=='${PREFIX}-UserPoolClient'].Value" \
    --output text)

  find "${TEMP_DIR}" -type f -name '*.yaml' -exec sed -i \
    -e "s/\${PREFIX}/${PREFIX}/g" \
    -e "s/\${COGNITO_USER_POOL_ID}/${COGNITO_USER_POOL_ID}/g" \
    -e "s/\${COGNITO_CLIENT_ID}/${COGNITO_CLIENT_ID}/g" \
    {} +

  : "${GRAFANA_ADMIN_USER:?Set GRAFANA_ADMIN_USER before deploying}"
  : "${GRAFANA_ADMIN_PASSWORD:?Set GRAFANA_ADMIN_PASSWORD before deploying}"

  KUBECONFIG="${kubeconfig_file}" kubectl create secret generic grafana-admin \
    --from-literal=username="${GRAFANA_ADMIN_USER}" \
    --from-literal=password="${GRAFANA_ADMIN_PASSWORD}" \
    --dry-run=client \
    -o yaml | KUBECONFIG="${kubeconfig_file}" kubectl apply -f -

  KUBECONFIG="${kubeconfig_file}" kubectl apply -k "${TEMP_DIR}/"
}

cmd_get_dashboard_token() {
  local token_file="target/dashboard-token"
  local kubeconfig_file="target/kubeconfig"

  if [ ! -f "${kubeconfig_file}" ]; then
    echo "Error: ${kubeconfig_file} not found." >&2
    echo "Run 'bin/k8s port-forward' or 'bin/k8s port-forward-warmup' first." >&2
    exit 1
  fi

  if ! nc -z localhost 6443 2>/dev/null; then
    echo "Error: Kubernetes API server is not available at localhost:6443" >&2
    echo "Run 'bin/k8s port-forward' or 'bin/k8s port-forward-warmup' first." >&2
    exit 1
  fi

  mkdir -p target
  KUBECONFIG="${kubeconfig_file}" kubectl create token dashboard-admin -n kubernetes-dashboard --duration=87600h | tee "${token_file}"
}

cmd_port_forward_warmup() {
  get_instance_info "warmup"

  local kubeconfig_file="target/kubeconfig"

  echo "Fetching kubeconfig from warmup instance: ${INSTANCE_ID}"

  SSH_OPTS=(
    -i "${KEY_FILE}"
    -o "ProxyCommand=aws ec2-instance-connect open-tunnel --instance-id ${INSTANCE_ID} --remote-port 22"
    -o StrictHostKeyChecking=no
    -o UserKnownHostsFile=/dev/null
    -o LogLevel=ERROR
    -o BatchMode=yes
    -o PasswordAuthentication=no
  )

  ssh "${SSH_OPTS[@]}" "root@${PRIVATE_IP}" "cat /etc/rancher/k3s/k3s.yaml" | \
    sed 's|server: https://.*:6443|server: https://localhost:6443|' > "${kubeconfig_file}"

  chmod 600 "${kubeconfig_file}"

  echo "Kubeconfig saved to: ${kubeconfig_file}"
  echo ""
  echo "Port-forwarding to warmup instance: ${INSTANCE_ID}"
  echo ""
  echo "Starting port-forward..."
  echo "  - Kubernetes API: https://localhost:6443"
  echo ""
  echo "For kubectl access:"
  echo "  export KUBECONFIG=\$(pwd)/target/kubeconfig"
  echo "  kubectl get nodes"
  echo ""
  echo "Press Ctrl-C to stop port-forward"
  echo ""

  exec ssh "${SSH_OPTS[@]}" -L 6443:localhost:6443 -N "root@${PRIVATE_IP}"
}

cmd_port_forward() {
  get_instance_info

  local kubeconfig_file="target/kubeconfig"

  echo "Fetching kubeconfig from instance: ${INSTANCE_ID}"

  PIDS=()
  SSH_OPTS=(
    -i "${KEY_FILE}"
    -o "ProxyCommand=aws ec2-instance-connect open-tunnel --instance-id ${INSTANCE_ID} --remote-port 22"
    -o StrictHostKeyChecking=no
    -o UserKnownHostsFile=/dev/null
    -o LogLevel=ERROR
    -o BatchMode=yes
    -o PasswordAuthentication=no
  )

  ssh "${SSH_OPTS[@]}" "root@${PRIVATE_IP}" "cat /etc/rancher/k3s/k3s.yaml" | \
    sed 's|server: https://.*:6443|server: https://localhost:6443|' > "${kubeconfig_file}"

  chmod 600 "${kubeconfig_file}"

  echo "Kubeconfig saved to: ${kubeconfig_file}"
  echo ""

  cleanup() {
    echo ""
    echo "Stopping all port-forwards..."
    for pid in "${PIDS[@]}"; do
      kill "${pid}" 2>/dev/null || true
    done
  }

  trap cleanup SIGINT SIGTERM EXIT

  cleanup_existing_forwards() {
    echo "Checking for existing port-forward processes..."

    local pids
    pids=$(pgrep -f "ssh.*kubectl port-forward" || true)
    if [ -n "${pids}" ]; then
      echo "Found existing local port-forward processes, killing them..."
      echo "${pids}" | xargs kill 2>/dev/null || true
      sleep 1
    fi

    echo "Checking remote port-forward processes..."
    ssh "${SSH_OPTS[@]}" "root@${PRIVATE_IP}" \
      "pkill kubectl 2>/dev/null && echo 'Killed remote kubectl processes' || echo 'No remote processes found'"
    sleep 1
  }

  check_port() {
    local port=$1
    if lsof -Pi :"${port}" -sTCP:LISTEN -t >/dev/null 2>&1 || \
       ss -tuln | grep -q ":${port}\s"; then
      echo "Error: Port ${port} is already in use" >&2
      echo "Run this command to find and kill the process:" >&2
      echo "  lsof -ti:${port} | xargs kill -9" >&2
      return 1
    fi
    return 0
  }

  start_port_forward() {
    local port=$1
    local remote_cmd=$2
    local label=$3

    ssh "${SSH_OPTS[@]}" \
      -L "${port}":localhost:"${port}" \
      "root@${PRIVATE_IP}" \
      "${remote_cmd}" 2>&1 | sed "s/^/[${label}] /" &
  }

  cleanup_existing_forwards

  echo "Checking if ports are available..."
  check_port 6443 || exit 1
  check_port 8443 || exit 1
  check_port 9090 || exit 1
  check_port 3000 || exit 1
  check_port 8317 || exit 1

  echo ""
  echo "Starting port-forwards..."
  echo "  - Kubernetes API: https://localhost:6443"
  echo "  - Kubernetes Dashboard: https://localhost:8443"
  echo "  - Prometheus: http://localhost:9090"
  echo "  - Grafana: http://localhost:3000"
  echo "  - CLIProxyAPI: http://localhost:8317"
  echo ""
  echo "For kubectl access:"
  echo "  export KUBECONFIG=\$(pwd)/target/kubeconfig"
  echo "  kubectl get nodes"
  echo ""
  echo "Press Ctrl-C to stop all port-forwards"
  echo ""

  ssh "${SSH_OPTS[@]}" -L 6443:localhost:6443 -N "root@${PRIVATE_IP}" 2>&1 | sed 's/^/[K8s API] /' &
  PIDS+=($!)

  start_port_forward 8443 "kubectl port-forward -n kubernetes-dashboard svc/kubernetes-dashboard 8443:443" "Dashboard"
  PIDS+=($!)

  start_port_forward 9090 "kubectl port-forward svc/prometheus 9090:9090" "Prometheus"
  PIDS+=($!)

  start_port_forward 3000 "kubectl port-forward svc/grafana 3000:3000" "Grafana"
  PIDS+=($!)

  start_port_forward 8317 "kubectl port-forward svc/cli-proxy-api 8317:8317" "CLIProxyAPI"
  PIDS+=($!)

  wait
}

cmd_help() {
  cat <<EOF
Usage: bin/k8s <command>

Commands:
  deploy                Deploy all Kubernetes resources (requires port-forward)
  get-dashboard-token   Get Kubernetes Dashboard token
  port-forward          Port-forward all services and download kubeconfig
  port-forward-warmup   Port-forward Kubernetes API to warmup instance and download kubeconfig
  help                  Show this help message

Environment Variables:
  PREFIX                Resource prefix (default: dev-k8s)
  AWS_PROFILE           AWS profile to use
  GRAFANA_ADMIN_USER    Grafana admin username for deploy
  GRAFANA_ADMIN_PASSWORD Grafana admin password for deploy

Local kubectl access (healthy instance):
  Terminal 1: AWS_PROFILE=conao3.k8s bin/k8s port-forward
  Terminal 2: export KUBECONFIG=\$(pwd)/target/kubeconfig
  Terminal 2: AWS_PROFILE=conao3.k8s bin/k8s deploy

Deploy to warmup instance:
  Terminal 1: AWS_PROFILE=conao3.k8s bin/k8s port-forward-warmup
  Terminal 2: export KUBECONFIG=\$(pwd)/target/kubeconfig
  Terminal 2: AWS_PROFILE=conao3.k8s bin/k8s deploy
EOF
}

case "${1:-help}" in
  deploy)
    cmd_deploy
    ;;
  get-dashboard-token)
    cmd_get_dashboard_token
    ;;
  port-forward)
    cmd_port_forward
    ;;
  port-forward-warmup)
    cmd_port_forward_warmup
    ;;
  help|--help|-h)
    cmd_help
    ;;
  *)
    echo "Error: Unknown command '${1}'" >&2
    echo "" >&2
    cmd_help
    exit 1
    ;;
esac
