#!/usr/bin/env bash
set -euxo pipefail -o posix

PROFILE="conao3.k8s"
PREFIX="dev-k8s"
AMI_ID_FILE="target/ami-id.txt"

get_s3_bucket() {
  aws cloudformation list-exports \
    --profile "${PROFILE}" \
    --query "Exports[?Name=='${PREFIX}-VmImportBucket'].Value" \
    --output text
}

get_vhd_file() {
  local vhd_file
  vhd_file=$(ls -1 result/*.vhd 2>/dev/null | sort -r | head -n 1)
  if [ -z "${vhd_file}" ]; then
    echo "Error: No VHD file found in result/. Run 'bin/image build' first." >&2
    exit 1
  fi
  echo "${vhd_file}"
}

cmd_build() {
  echo "Building Amazon AMI image (aarch64)..."
  nix build .#imageAmazon
  local vhd_file
  vhd_file=$(get_vhd_file)
  echo "Image built successfully: ${vhd_file}"
}

cmd_upload() {
  local vhd_file
  vhd_file=$(get_vhd_file)

  local s3_bucket
  s3_bucket=$(get_s3_bucket)
  echo "Using S3 bucket: ${s3_bucket}"

  local timestamp
  timestamp=$(date +%Y%m%d-%H%M%S)
  local s3_key="nixos-custom-${timestamp}.vhd"

  echo "Uploading image to S3 as ${s3_key}..."
  aws s3 cp "${vhd_file}" "s3://${s3_bucket}/${s3_key}" --profile "${PROFILE}"
  echo "Image uploaded successfully"

  echo "Starting snapshot import..."
  local import_task_id
  import_task_id=$(aws ec2 import-snapshot \
    --description "NixOS Custom EC2 Image ${timestamp}" \
    --disk-container "Format=VHD,UserBucket={S3Bucket=${s3_bucket},S3Key=${s3_key}}" \
    --profile "${PROFILE}" \
    --query 'ImportTaskId' \
    --output text)
  echo "Import task ID: ${import_task_id}"

  echo "Waiting for snapshot import to complete..."
  while true; do
    local status
    status=$(aws ec2 describe-import-snapshot-tasks \
      --import-task-ids "${import_task_id}" \
      --profile "${PROFILE}" \
      --query 'ImportSnapshotTasks[0].SnapshotTaskDetail.Status' \
      --output text)
    echo "Current status: ${status}"

    if [ "${status}" = "completed" ]; then
      break
    elif [ "${status}" = "deleted" ] || [ "${status}" = "deleting" ]; then
      echo "Import failed with status: ${status}"
      exit 1
    fi
    sleep 30
  done

  local snapshot_id
  snapshot_id=$(aws ec2 describe-import-snapshot-tasks \
    --import-task-ids "${import_task_id}" \
    --profile "${PROFILE}" \
    --query 'ImportSnapshotTasks[0].SnapshotTaskDetail.SnapshotId' \
    --output text)
  echo "Snapshot created: ${snapshot_id}"

  echo "Registering AMI..."
  local ami_id
  ami_id=$(aws ec2 register-image \
    --name "nixos-custom-${timestamp}" \
    --description "NixOS Custom Image ${timestamp}" \
    --architecture arm64 \
    --root-device-name '/dev/xvda' \
    --block-device-mappings "DeviceName=/dev/xvda,Ebs={SnapshotId=${snapshot_id},VolumeSize=20,VolumeType=gp3}" \
    --virtualization-type hvm \
    --ena-support \
    --profile "${PROFILE}" \
    --query 'ImageId' \
    --output text)
  echo "AMI created: ${ami_id}"

  mkdir -p target
  echo "${ami_id}" > "${AMI_ID_FILE}"
  echo "AMI ID saved to ${AMI_ID_FILE}"
}

cmd_deploy() {
  if [ ! -f "${AMI_ID_FILE}" ]; then
    echo "Error: ${AMI_ID_FILE} not found. Run 'bin/image upload' first."
    exit 1
  fi

  local ami_id
  ami_id=$(cat "${AMI_ID_FILE}")
  echo "Deploying cluster with custom AMI: ${ami_id}"
  AWS_PROFILE="${PROFILE}" clojure -M -m conao3.aws-infra-k8s deploy cluster --ami-id "${ami_id}"

  echo ""
  echo "Starting instance refresh to update running instances..."
  local asg_name="${PREFIX}-node"
  aws autoscaling start-instance-refresh \
    --auto-scaling-group-name "${asg_name}" \
    --profile "${PROFILE}"

  echo "Instance refresh started. Waiting for completion..."
  while true; do
    local status
    status=$(aws autoscaling describe-instance-refreshes \
      --auto-scaling-group-name "${asg_name}" \
      --profile "${PROFILE}" \
      --query 'InstanceRefreshes[0].Status' \
      --output text)

    local percentage
    percentage=$(aws autoscaling describe-instance-refreshes \
      --auto-scaling-group-name "${asg_name}" \
      --profile "${PROFILE}" \
      --query 'InstanceRefreshes[0].PercentageComplete' \
      --output text)

    echo "Status: ${status}, Progress: ${percentage}%"

    if [ "${status}" = "Successful" ]; then
      echo "Instance refresh completed successfully!"
      break
    elif [ "${status}" = "Failed" ] || [ "${status}" = "Cancelled" ]; then
      echo "Instance refresh failed with status: ${status}"
      exit 1
    fi

    sleep 10
  done

  echo ""
  echo "Deployment complete! New instance is now running with custom AMI."
}

cmd_help() {
  cat <<EOF
Usage: bin/image <command>

Commands:
  build     Build the Amazon AMI image (aarch64)
  upload    Upload image to S3, import snapshot, and register AMI
  deploy    Deploy cluster with custom AMI and refresh instances
  help      Show this help message

Workflow:
  1. bin/image build   - Build the image
  2. bin/image upload  - Upload and register as AMI
  3. bin/image deploy  - Deploy cluster and refresh running instances with the AMI
EOF
}

case "${1:-help}" in
  build)
    cmd_build
    ;;
  upload)
    cmd_upload
    ;;
  deploy)
    cmd_deploy
    ;;
  help|--help|-h)
    cmd_help
    ;;
  *)
    echo "Error: Unknown command '${1}'"
    echo ""
    cmd_help
    exit 1
    ;;
esac
