#!/usr/bin/env bash
set -euxo pipefail -o posix

CLUSTER_NAME="${CLUSTER_NAME:-dev-k8s-local}"

cmd_up() {
  if kind get clusters | grep -q "^${CLUSTER_NAME}$"; then
    return
  fi

  kind create cluster --name "${CLUSTER_NAME}" --config - <<EOF
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
nodes:
- role: control-plane
  extraPortMappings:
  - containerPort: 30080
    hostPort: 30080
    protocol: TCP
  - containerPort: 31353
    hostPort: 31353
    protocol: TCP
  - containerPort: 30900
    hostPort: 30900
    protocol: TCP
  - containerPort: 30300
    hostPort: 30300
    protocol: TCP
EOF
}

cmd_deploy() {
  if ! kind get clusters | grep -q "^${CLUSTER_NAME}$"; then
    echo "Error: Cluster ${CLUSTER_NAME} does not exist. Run 'bin/k8s/local up' first." >&2
    exit 1
  fi

  kubectl config use-context "kind-${CLUSTER_NAME}"

  MANIFESTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/k8s"

  : "${GRAFANA_ADMIN_USER:?Set GRAFANA_ADMIN_USER before deploying}"
  : "${GRAFANA_ADMIN_PASSWORD:?Set GRAFANA_ADMIN_PASSWORD before deploying}"

  kubectl create secret generic grafana-admin \
    --from-literal=username="${GRAFANA_ADMIN_USER}" \
    --from-literal=password="${GRAFANA_ADMIN_PASSWORD}" \
    --dry-run=client \
    -o yaml | kubectl apply -f -

  kubectl apply -k "${MANIFESTS_DIR}/traefik/"
  kubectl apply -k "${MANIFESTS_DIR}/app1/"
  kubectl apply -k "${MANIFESTS_DIR}/app2/"
  kubectl apply -k "${MANIFESTS_DIR}/app3/"
  kubectl apply -k "${MANIFESTS_DIR}/kubernetes-dashboard/"
  kubectl apply -k "${MANIFESTS_DIR}/node-exporter/"
  kubectl apply -k "${MANIFESTS_DIR}/kube-state-metrics/"
  kubectl apply -k "${MANIFESTS_DIR}/prometheus/"
  sed 's/name: grafana-storage$/name: grafana-storage-efs/' "${MANIFESTS_DIR}/grafana/pvc.yaml" | kubectl apply -f -
  kubectl apply -f "${MANIFESTS_DIR}/grafana/datasource-configmap.yaml"
  kubectl apply -f "${MANIFESTS_DIR}/grafana/service.yaml"
  kubectl apply -f "${MANIFESTS_DIR}/grafana/deployment.yaml"
  kubectl apply -f "${MANIFESTS_DIR}/grafana/network-policy.yaml"

  kubectl wait --for=condition=ready pod -l app=traefik -n traefik --timeout=60s
  kubectl wait --for=condition=ready pod -l app=app1 --timeout=60s
  kubectl wait --for=condition=ready pod -l app=app2 --timeout=60s
  kubectl wait --for=condition=ready pod -l app=app3 --timeout=60s
  kubectl wait --for=condition=ready pod -l k8s-app=kubernetes-dashboard -n kubernetes-dashboard --timeout=60s
  kubectl wait --for=condition=ready pod -l app=node-exporter --timeout=60s
  kubectl wait --for=condition=ready pod -l app=kube-state-metrics -n kube-system --timeout=60s
  kubectl wait --for=condition=ready pod -l app=prometheus --timeout=60s
  kubectl wait --for=condition=ready pod -l app=grafana --timeout=60s

  kubectl get pods -A
}

cmd_token() {
  if ! kind get clusters | grep -q "^${CLUSTER_NAME}$"; then
    echo "Error: Cluster ${CLUSTER_NAME} does not exist. Run 'bin/k8s/local up' first." >&2
    exit 1
  fi

  kubectl config use-context "kind-${CLUSTER_NAME}"

  kubectl create token dashboard-admin -n kubernetes-dashboard --duration=87600h
}

cmd_down() {
  if ! kind get clusters | grep -q "^${CLUSTER_NAME}$"; then
    return
  fi

  kind delete cluster --name "${CLUSTER_NAME}"
}

cmd_help() {
  cat <<EOF
Usage: bin/k8s/local <command>

Commands:
  up       Create local kind cluster
  deploy   Deploy applications to local cluster
  token    Get Kubernetes Dashboard token
  down     Delete local cluster
  help     Show this help message

Environment Variables:
  CLUSTER_NAME   Name of the kind cluster (default: dev-k8s-local)
  GRAFANA_ADMIN_USER   Grafana admin username for deploy
  GRAFANA_ADMIN_PASSWORD Grafana admin password for deploy

Examples:
  bin/k8s/local up
  bin/k8s/local deploy
  bin/k8s/local token
  bin/k8s/local down
EOF
}

case "${1:-help}" in
  up)
    cmd_up
    ;;
  deploy)
    cmd_deploy
    ;;
  token)
    cmd_token
    ;;
  down)
    cmd_down
    ;;
  help|--help|-h)
    cmd_help
    ;;
  *)
    echo "Error: Unknown command '${1}'"
    echo ""
    cmd_help
    exit 1
    ;;
esac
