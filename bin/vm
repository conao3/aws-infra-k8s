#!/usr/bin/env bash
set -euxo pipefail -o posix

cmd_run() {
  echo "Starting NixOS VM (x86_64)..."
  echo "To exit: Press Ctrl-A then X"
  echo ""
  QEMU_OPTS="${QEMU_OPTS:--m 4096 -smp 4}" nix run .#vm
}

cmd_help() {
  cat <<EOF
Usage: bin/vm [command]

Commands:
  run      Run the NixOS VM (default)
  help     Show this help message

Environment variables:
  QEMU_OPTS    QEMU options (default: "-m 4096 -smp 4")

Example:
  bin/vm run
  QEMU_OPTS="-m 8192 -smp 8" bin/vm run
EOF
}

case "${1:-run}" in
  run)
    cmd_run
    ;;
  help|--help|-h)
    cmd_help
    ;;
  *)
    echo "Error: Unknown command '${1}'"
    echo ""
    cmd_help
    exit 1
    ;;
esac
