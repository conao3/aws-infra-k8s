#!/usr/bin/env bash
set -euxo pipefail -o posix

STACK_NAME="${STACK_NAME:-dev-k8s-ami-builder}"
PREFIX="${PREFIX:-dev-k8s}"
KEY_FILE="${HOME}/.ssh/${PREFIX}-keypair.pem"

INSTANCE_ID=$(aws cloudformation describe-stacks \
  --stack-name "${STACK_NAME}" \
  --query 'Stacks[0].Outputs[?OutputKey==`InstanceAmiBuilder`].OutputValue' \
  --output text)

if [ -z "${INSTANCE_ID}" ]; then
  echo "Error: Could not find InstanceAmiBuilder from stack ${STACK_NAME}" >&2
  exit 1
fi

PRIVATE_IP=$(aws ec2 describe-instances \
  --instance-ids "${INSTANCE_ID}" \
  --query 'Reservations[0].Instances[0].PrivateIpAddress' \
  --output text)

echo "Connecting to ami-builder instance: ${INSTANCE_ID} (${PRIVATE_IP})" >&2

exec ssh -i "${KEY_FILE}" \
  -o "ProxyCommand=aws ec2-instance-connect open-tunnel --instance-id ${INSTANCE_ID} --remote-port 22" \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o LogLevel=ERROR \
  root@${PRIVATE_IP} \
  "$@"
