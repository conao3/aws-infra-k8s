#!/usr/bin/env bash
set -euxo pipefail -o posix

STACK_NAME="${STACK_NAME:-dev-k8s-ami-builder}"

INSTANCE_ID=$(aws cloudformation describe-stacks \
  --stack-name "${STACK_NAME}" \
  --query 'Stacks[0].Outputs[?OutputKey==`InstanceAmiBuilder`].OutputValue' \
  --output text)

if [ -z "${INSTANCE_ID}" ]; then
  echo "Error: Could not find InstanceAmiBuilder from stack ${STACK_NAME}" >&2
  exit 1
fi

echo "Connecting to ami-builder instance: ${INSTANCE_ID}" >&2

GPG_TTY=$(tty) SSH_ASKPASS="" aws ec2-instance-connect ssh \
  --instance-id "${INSTANCE_ID}" \
  --connection-type eice \
  "$@"
