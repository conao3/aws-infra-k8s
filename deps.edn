{:paths ["src" "resources"]
 :deps
 {org.clojure/clojure {:mvn/version "1.12.6"}
  camel-snake-kebab/camel-snake-kebab {:mvn/version "0.4.3"}
  babashka/process {:mvn/version "0.6.25"}
  babashka/fs {:mvn/version "0.5.34"}
  cheshire/cheshire {:mvn/version "6.2.0"}}
 :aliases
 {:build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}
  :native-image {:main-opts ["-m" "clj.native-image"
                              "conao3.aws-infra-k8s"
                              "--no-fallback"
                              "-H:+ReportExceptionStackTraces"
                              "--initialize-at-build-time"
                              "-H:Name=aws-infra-k8s"]
                 :extra-deps {clj.native-image/clj.native-image {:mvn/version "0.2.1"}}}}}
